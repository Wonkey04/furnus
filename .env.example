# Puerto de la API (HTTP + WebSocket)
FURNUS_API_PORT=4010
# Puerto del servicio del kernel (Python)
FURNUS_KERNEL_PORT=4020
# Carpeta de proyectos (por defecto ~/.furnus/proyectos)
# FURNUS_HOME=
# Python del kernel (por defecto services/kernel/.venv)
# FURNUS_PYTHON=
# Límites del sandbox
FURNUS_TIMEOUT_S=60
FURNUS_MEMORIA_MB=2048
# Chat del visor: usa el Claude Code instalado en tu computadora, con tu suscripción. No necesita clave de API
# (de hecho, ANTHROPIC_API_KEY se le quita al CLI para que no desvíe el uso). Instalación y login: ver el panel del chat.
# Modelo del chat (por defecto el que Claude Code elija para tu plan; ej.: claude-sonnet-5-5)
# FURNUS_MODELO=
# Ruta del ejecutable `claude` si no está en el PATH
# FURNUS_CLAUDE_BIN=
