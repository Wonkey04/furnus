# Puerto de la API (HTTP + WebSocket)
FURNUS_API_PORT=4010
# Puerto del servicio del kernel (Python)
FURNUS_KERNEL_PORT=4020
# Carpeta de proyectos (por defecto ~/.furnus/proyectos)
# FURNUS_HOME=
# Python del kernel (por defecto services/kernel/.venv)
# FURNUS_PYTHON=
# Límites del sandbox
FURNUS_TIMEOUT_S=60
FURNUS_MEMORIA_MB=2048
# Chat del visor: clave de la API de Anthropic (https://console.anthropic.com). Sin ella el chat queda deshabilitado
# y se puede seguir usando un agente externo por MCP. NO la subas al repo: .env está en .gitignore.
ANTHROPIC_API_KEY=
# Modelo del chat (por defecto claude-opus-5-5)
# FURNUS_MODELO=
